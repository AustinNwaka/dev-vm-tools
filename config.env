# =============================================================================
# vm-tools bootstrap configuration
# Edit this file to pin versions or enable/disable tools before running install.sh
# =============================================================================

# ---------------------------------------------------------------------------
# Tool enable/disable flags  (set to "true" or "false")
# ---------------------------------------------------------------------------
# Core
INSTALL_GIT=true           # ensure a recent Git is present
INSTALL_CURL=true          # usually pre-installed; ensured here
INSTALL_MAKE=true          # GNU Make
INSTALL_UNZIP=true
INSTALL_JQ=true            # JSON processor (used heavily in CI/CD)
INSTALL_UV=true
INSTALL_PNPM=true
INSTALL_NODE=true          # installs Node.js LTS via nvm
INSTALL_GOLANG=true

# IaC / DevOps
INSTALL_DOCKER=true        # Docker Engine (Ubuntu/Debian) or Podman (RHEL/macOS)
INSTALL_ANSIBLE=false      # installed with uv tool install ansible-core --with ansible
INSTALL_TERRAFORM=false

# Developer Experience
INSTALL_RUFF=true
INSTALL_OPENCODE=true
INSTALL_DIRENV=true        # per-directory env vars (.envrc)
INSTALL_STARSHIP=false     # fast, cross-shell prompt (set false if using bash_prompt)
INSTALL_BASH_PROMPT=true   # minimal CWD + git-branch PS1 (bash only; disable if using starship)
INSTALL_RIPGREP=true       # rg — fast grep (used by editors, fzf, etc.)
INSTALL_FZF=true           # fuzzy finder
INSTALL_HTOP=true
INSTALL_TREE=true

# ---------------------------------------------------------------------------
# Pinned versions  (set to "" to always pull latest stable)
# ---------------------------------------------------------------------------
NODE_VERSION="lts/*"       # nvm version selector; e.g. "lts/iron" or "22"
GO_VERSION=""              # "" = latest stable from go.dev
PNPM_VERSION=""            # "" = latest from pnpm.io
ANSIBLE_VERSION=""         # "" = latest ansible-core; e.g. "2.18.3"
# uv, ruff, opencode, and starship are installed from their latest stable channels.
# Terraform is installed from HashiCorp's official repository or Homebrew tap.

# ---------------------------------------------------------------------------
# Install prefix / shell config
# ---------------------------------------------------------------------------
SHELL_RC=""                # "" = auto-detect (~/.bashrc or ~/.zshrc)
                           # or set explicitly: "/home/user/.bashrc"
